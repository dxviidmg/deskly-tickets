# =============================================================================
# Deskly — variables de entorno de ejemplo
# -----------------------------------------------------------------------------
# Copia este archivo a .env y ajusta los valores:
#     cp .env.example .env
#
# El archivo .env NO se versiona (está en .gitignore). Aquí solo hay valores
# de ejemplo / placeholders: ningún secreto real.
# =============================================================================

# --- Base de datos (PostgreSQL) ---------------------------------------------
# Credenciales que usa el contenedor de Postgres para inicializarse.
POSTGRES_USER=deskly
POSTGRES_PASSWORD=deskly
POSTGRES_DB=deskly

# URL de conexión que usa el backend (driver async).
# El host "db" es el nombre del servicio de Postgres en docker-compose.
DATABASE_URL=postgresql+asyncpg://deskly:deskly@db:5432/deskly

# --- Redis (pub/sub para WebSocket en tiempo real) --------------------------
# Bus de eventos para que las notificaciones WebSocket lleguen a los clientes
# aunque haya varias instancias del backend. El host "redis" es el nombre del
# servicio en docker-compose.
REDIS_URL=redis://redis:6379/0

# --- Webhook ----------------------------------------------------------------
# Secreto compartido para verificar la firma HMAC-SHA256 del webhook.
# CÁMBIALO por un valor largo y aleatorio. No dejes "change-me" en producción.
WEBHOOK_SECRET=change-me

# Antigüedad máxima (segundos) aceptada para el timestamp del webhook
# (protección contra replay). Por defecto, 5 minutos.
WEBHOOK_MAX_AGE_SECONDS=300

# --- Autenticación (JWT) ----------------------------------------------------
# Secreto para firmar los tokens JWT. CÁMBIALO por un valor largo y aleatorio.
JWT_SECRET=change-me-too
# Algoritmo y expiración del token (minutos).
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Usuario administrador inicial que crea el seed (primer acceso).
# Cámbialo tras el primer inicio de sesión.
ADMIN_EMAIL=admin@deskly.com
ADMIN_PASSWORD=admin123

# --- CORS -------------------------------------------------------------------
# Orígenes permitidos para el frontend (separados por coma si son varios).
CORS_ORIGINS=http://localhost:3000

# --- Seed -------------------------------------------------------------------
# Si es "true", al arrancar el backend inserta tickets de ejemplo (si la tabla
# está vacía). Ponlo en "false" para no sembrar datos.
DESKLY_SEED=true

# --- Frontend (Next.js) -----------------------------------------------------
# URL del API a la que llama el navegador (peticiones REST desde el cliente).
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL del WebSocket de tiempo real.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/tickets
# URL del API para el renderizado en servidor (SSR). Dentro de docker-compose
# el frontend habla con el backend por el nombre del servicio ("api").
API_INTERNAL_URL=http://api:8000
