# =============================================================================
# Deskly — variables de entorno del FRONTEND (Next.js) (ejemplo)
# -----------------------------------------------------------------------------
# Copia este archivo a web/.env:
#     cp web/.env.example web/.env
#
# Este archivo NO se versiona (está en .gitignore).
# =============================================================================

# --- URLs públicas (BUILD-TIME) ---------------------------------------------
# IMPORTANTE: las variables NEXT_PUBLIC_* se "hornean" en el bundle de
# JavaScript cuando se CONSTRUYE la imagen (build-time), NO en runtime. Las usa
# el NAVEGADOR para hablar con el API y el WebSocket.
#
# En docker-compose.yml se pasan como build args del servicio "web". Cambiarlas
# aquí solo tiene efecto si reconstruyes la imagen (docker compose build web).
#
# URL del API a la que llama el navegador (peticiones REST desde el cliente).
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL del WebSocket de tiempo real.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/tickets

# --- URL interna (RUNTIME, solo servidor) -----------------------------------
# API_INTERNAL_URL la usa el servidor de Next (SSR) en RUNTIME para llamar al
# backend. Dentro de docker-compose el frontend habla con el backend por el
# NOMBRE del servicio ("api"), no por localhost.
API_INTERNAL_URL=http://api:8000
